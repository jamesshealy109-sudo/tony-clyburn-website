# Canonical origin. Use the GitHub Pages URL during preview and the custom domain only after cutover.
NEXT_PUBLIC_SITE_URL=https://jamesshealy109-sudo.github.io/tony-clyburn-website

# GitHub Pages project path. Leave empty when the custom domain is active.
NEXT_PUBLIC_BASE_PATH=/tony-clyburn-website

# Add only after Google Search Console supplies the HTML meta-tag verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Add only after a GA4 property is approved and its Measurement ID is supplied.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

